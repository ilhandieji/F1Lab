[Unit]
Description=F1Lab Next.js Application
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/F1Lab
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/apps/F1Lab/.env
ExecStart=/usr/bin/pnpm start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
